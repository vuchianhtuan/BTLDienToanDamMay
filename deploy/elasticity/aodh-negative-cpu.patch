diff --git a/aodh/evaluator/gnocchi.py b/aodh/evaluator/gnocchi.py
--- a/aodh/evaluator/gnocchi.py
+++ b/aodh/evaluator/gnocchi.py
@@ -56,5 +56,10 @@ class GnocchiBase(threshold.ThresholdEvaluator):
             raise threshold.InsufficientDataError(
                 "No datapoint for granularity %s" % rule['granularity'], [])
         statistics = statistics[-rule['evaluation_periods']:]
+        if (rule.get('metric') == 'cpu' and
+                rule.get('aggregation_method') == 'rate:mean'):
