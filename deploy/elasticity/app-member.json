{
  "heat_template_version": "2018-08-31",
  "description": "One App VM and its pool member; deleting the nested stack removes both.",
  "parameters": {
    "image_id": {
      "type": "string",
      "description": "Private prepared Glance image UUID with Docker, cloud-init and preloaded app image."
    },
    "flavor_id": {
      "type": "string",
      "description": "App flavor ID."
    },
    "network_id": {
      "type": "string",
      "description": "Private App network UUID."
    },
    "member_subnet_id": {
      "type": "string",
      "description": "Private App subnet UUID."
    },
    "app_security_group_id": {
      "type": "string",
      "description": "Existing restricted App security group UUID."
    },
    "key_name": {
      "type": "string",
      "description": "Existing SSH keypair name."
    },
    "availability_zone": {
      "type": "string",
      "description": "Target compute AZ."
    },
    "pool_id": {
      "type": "string",
      "description": "Octavia pool UUID."
    },
    "metering_group": {
      "type": "string",
      "description": "Unique stack/AZ metric dimension."
    },
    "container_image": {
      "type": "string",
      "description": "Preloaded Docker image reference; no pull or build on boot."
    },
    "app_env_b64": {
      "type": "string",
      "description": "Base64 dotenv, confidential lab input; hidden is not encryption.",
      "hidden": true
    }
  },
  "resources": {
    "boot_config": {
      "type": "OS::Heat::CloudConfig",
      "properties": {
        "cloud_config": {
          "write_files": [
            {
              "path": "/etc/file-integrity/app.env",
              "permissions": "0600",
              "owner": "root:root",
              "encoding": "b64",
              "content": {
                "get_param": "app_env_b64"
              }
            }
          ],
          "runcmd": [
            [
              "systemctl",
              "enable",
              "--now",
              "docker"
            ],
            [
              "docker",
              "image",
              "inspect",
              {
                "get_param": "container_image"
              }
            ],
            [
              "docker",
              "run",
              "--detach",
              "--name",
              "file-integrity",
              "--restart",
              "unless-stopped",
              "--pull",
              "never",
              "--env-file",
              "/etc/file-integrity/app.env",
              "--publish",
              "8000:8000",
              {
                "get_param": "container_image"
              }
            ]
          ]
        }
      }
    },
    "server": {
      "type": "OS::Nova::Server",
      "properties": {
        "image": {
          "get_param": "image_id"
        },
        "flavor": {
          "get_param": "flavor_id"
        },
        "key_name": {
          "get_param": "key_name"
        },
        "availability_zone": {
          "get_param": "availability_zone"
        },
        "networks": [
          {
            "network": {
              "get_param": "network_id"
            },
            "subnet": {
              "get_param": "member_subnet_id"
            }
          }
        ],
        "security_groups": [
          {
            "get_param": "app_security_group_id"
          }
        ],
        "metadata": {
          "metering.server_group": {
            "get_param": "metering_group"
          }
        },
        "user_data_format": "RAW",
        "user_data": {
          "get_attr": [
            "boot_config",
            "config"
          ]
        }
      }
    },
    "member": {
      "type": "OS::Octavia::PoolMember",
      "properties": {
        "pool": {
          "get_param": "pool_id"
        },
        "address": {
          "get_attr": [
            "server",
            "first_address"
          ]
        },
        "subnet": {
          "get_param": "member_subnet_id"
        },
        "protocol_port": 8000
      }
    }
  },
  "outputs": {
    "server_id": {
      "value": {
        "get_resource": "server"
      }
    }
  }
}
