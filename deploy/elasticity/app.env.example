# Docker --env-file format: no quotes, no export, one value per line.
# URL-encode the database username/password; use shared remote storage.
STORAGE_BACKEND=swift
DATABASE_URL=postgresql+psycopg://integrity:CHANGE_ME@DB_PRIVATE_IP:5432/integrity
APP_API_KEY=CHANGE_ME
OS_AUTH_URL=http://CONTROLLER_PRIVATE_IP:5000/v3
OS_APPLICATION_CREDENTIAL_ID=CHANGE_ME
OS_APPLICATION_CREDENTIAL_SECRET=CHANGE_ME
OS_REGION_NAME=RegionOne
OS_INTERFACE=internal
SWIFT_CONTAINER=file-integrity
MAX_FILE_BYTES=26214400
