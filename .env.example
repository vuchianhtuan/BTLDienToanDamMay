# Local demo only. Change password before deployment; never commit .env.
POSTGRES_PASSWORD=local-demo-change-me
APP_PORT=8000
STORAGE_BACKEND=local
MAX_FILE_BYTES=26214400
# Optional shared API key for this lab (not per-user authentication).
APP_API_KEY=
# Swift: provision the container and assign scoped permissions beforehand.
OS_AUTH_URL=
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
OS_REGION_NAME=RegionOne
OS_INTERFACE=internal
SWIFT_CONTAINER=file-integrity
